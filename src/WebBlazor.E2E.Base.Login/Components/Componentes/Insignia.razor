@* Insignia de estado. Imprime SIEMPRE el texto: el color no es el único canal. *@

<span class="mq-insignia @Clase">@Valor</span>

@code {
    /// <summary>Rótulo de interfaz del estado, ya concordado en género.</summary>
    [Parameter, EditorRequired] public string Valor { get; set; } = default!;

    /// <summary>Tono semántico con el que se pinta el par texto + tint.</summary>
    [Parameter] public Tono Tono { get; set; } = Tono.Neutro;

    private string Clase => Tono switch
    {
        Tono.Exito => "mq-insignia--exito",
        Tono.Atencion => "mq-insignia--atencion",
        Tono.Peligro => "mq-insignia--peligro",
        Tono.Info => "mq-insignia--info",
        _ => string.Empty
    };
}
