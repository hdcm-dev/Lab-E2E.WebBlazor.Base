@* Espera de una colección: se dibuja la forma de lo que viene, no un spinner. El
   bloque es decorativo, y lo que se está cargando se dice en la región activa de
   la superficie. *@

<div aria-hidden="true">
    @for (var i = 0; i < Filas; i++)
    {
        <div class="mq-esqueleto mq-esqueleto--fila"></div>
    }
</div>

@code {
    /// <summary>Cuántas filas se insinúan mientras llega la colección.</summary>
    [Parameter] public int Filas { get; set; } = 3;
}
